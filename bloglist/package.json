{
  "name": "bloglist",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "cross-env NODE_ENV=production npm --prefix server run start",
    "test:server": "npm --prefix server run test",
    "test:client": "npm --prefix client run test",
    "lint": "npm --prefix client run lint"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3"
  }
}
