{
  "name": "bloglist",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "concurrently \"pnpm -C server dev\" \"pnpm -C client dev\"",
    "build": "pnpm -C client build",
    "start": "cross-env NODE_ENV=production pnpm -C server start",
    "test:server": "pnpm -C server test",
    "test:client": "pnpm -C client test",
    "lint": "pnpm -C client lint"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3"
  }
}
